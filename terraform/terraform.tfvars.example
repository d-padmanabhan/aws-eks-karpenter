# AWS Configuration
aws_region  = "us-east-1"
environment = "production"

# EKS Configuration
cluster_name    = "todo-app-cluster"
cluster_version = "1.28"

# Pod Authentication Mode
# Options: "irsa" (IAM Roles for Service Accounts - traditional, battle-tested)
#          "pod-identity" (EKS Pod Identity - newer, simpler, GA since 2023)
# Default: "irsa"
pod_authentication_mode = "irsa"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# DynamoDB Configuration
dynamodb_table_name = "todo-app-table"

# Node Group Configuration
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 1
node_max_size       = 4
